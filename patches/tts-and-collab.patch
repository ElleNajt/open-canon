@@ -0,0 +1,323 @@
+import { useState, useEffect, useRef, useImperativeHandle, forwardRef } from 'react';
+
+const WS_URL = `${window.location.protocol === 'https:' ? 'wss:' : 'ws:'}//${window.location.host}/ws`;
+
+const CollabPanel = forwardRef(function CollabPanel({ onCodeUpdate, height, onHeightChange }, ref) {
+  const [name, setName] = useState(() => localStorage.getItem('collabName') || '');
+  const [prompt, setPrompt] = useState('');
+  const [queue, setQueue] = useState([]);
+  const [history, setHistory] = useState([]);
+  const [connected, setConnected] = useState(false);
+  const [expanded, setExpanded] = useState(true);
+  const [image, setImage] = useState(null); // {data: base64, type: mime}
+  const [repeating, setRepeating] = useState([]); // server-side repeating prompts
+  const [repeatInterval, setRepeatInterval] = useState(30);
+  const wsRef = useRef(null);
+  const fileInputRef = useRef(null);
+
+  // Expose methods via ref
+  useImperativeHandle(
+    ref,
+    () => ({
+      sendError: (message, code) => {
+        console.log('[CollabPanel] sendError called:', message);
+        if (wsRef.current?.readyState === WebSocket.OPEN) {
+          console.log('[CollabPanel] Sending to server with code');
+          wsRef.current.send(JSON.stringify({ type: 'error', message, code }));
+        } else {
+          console.log('[CollabPanel] WebSocket not open, state:', wsRef.current?.readyState);
+        }
+      },
+      sendUserEdit: (code) => {
+        const userName = localStorage.getItem('collabName') || 'Anonymous';
+        if (wsRef.current?.readyState === WebSocket.OPEN) {
+          wsRef.current.send(JSON.stringify({ type: 'userEdit', name: userName, code }));
+        }
+      },
+    }),
+    [],
+  );
+
+  useEffect(() => {
+    let ws;
+    let reconnectTimeout;
+
+    const connect = () => {
+      ws = new WebSocket(WS_URL);
+      wsRef.current = ws;
+
+      ws.onopen = () => {
+        console.log('[CollabPanel] WebSocket connected');
+        setConnected(true);
+      };
+
+      ws.onclose = () => {
+        console.log('[CollabPanel] WebSocket closed, reconnecting in 2s...');
+        setConnected(false);
+        reconnectTimeout = setTimeout(connect, 2000);
+      };
+
+      ws.onerror = (err) => {
+        console.log('[CollabPanel] WebSocket error:', err);
+        ws.close();
+      };
+
+      ws.onmessage = (e) => {
+        const msg = JSON.parse(e.data);
+
+        if (msg.type === 'init') {
+          setQueue(msg.queue);
+          setHistory(msg.history);
+          setRepeating(msg.repeating || []);
+          if (msg.code) onCodeUpdate(msg.code);
+        } else if (msg.type === 'queue') {
+          setQueue(msg.queue);
+        } else if (msg.type === 'update') {
+          setHistory(msg.history);
+          onCodeUpdate(msg.entry.code);
+        } else if (msg.type === 'repeating') {
+          setRepeating(msg.repeating || []);
+        }
+      };
+    };
+
+    connect();
+
+    return () => {
+      clearTimeout(reconnectTimeout);
+      ws?.close();
+    };
+  }, [onCodeUpdate]);
+
+  const handleImageSelect = (e) => {
+    const file = e.target.files?.[0];
+    if (!file) return;
+
+    const reader = new FileReader();
+    reader.onload = () => {
+      const base64 = reader.result.split(',')[1]; // Remove data:image/...;base64, prefix
+      setImage({ data: base64, type: file.type });
+    };
+    reader.readAsDataURL(file);
+  };
+
+  const clearImage = () => {
+    setImage(null);
+    if (fileInputRef.current) fileInputRef.current.value = '';
+  };
+
+  const sendPrompt = (promptText) => {
+    if (!promptText.trim() || !name.trim() || !wsRef.current) return;
+
+    localStorage.setItem('collabName', name);
+    const msg = {
+      type: 'prompt',
+      name: name.trim(),
+      prompt: promptText.trim(),
+    };
+    if (image) {
+      msg.image = image.data;
+      msg.imageType = image.type;
+    }
+    wsRef.current.send(JSON.stringify(msg));
+  };
+
+  const submit = () => {
+    if (!prompt.trim() || !name.trim()) return;
+    sendPrompt(prompt);
+    setPrompt('');
+    clearImage();
+  };
+
+  const addRepeating = () => {
+    if (!prompt.trim() || !name.trim() || !wsRef.current) return;
+
+    localStorage.setItem('collabName', name);
+    wsRef.current.send(
+      JSON.stringify({
+        type: 'addRepeating',
+        name: name.trim(),
+        prompt: prompt.trim(),
+        interval: repeatInterval,
+      }),
+    );
+    setPrompt('');
+    clearImage();
+  };
+
+  const removeRepeating = (id) => {
+    if (!wsRef.current) return;
+    wsRef.current.send(
+      JSON.stringify({
+        type: 'removeRepeating',
+        id,
+      }),
+    );
+  };
+
+  const clearQueue = () => {
+    if (!wsRef.current) return;
+    wsRef.current.send(JSON.stringify({ type: 'clearQueue' }));
+  };
+
+  const playVersion = (code) => {
+    onCodeUpdate(code);
+  };
+
+  const panelStyle = expanded ? (height ? { height: `${height}px` } : {}) : { height: '48px' };
+
+  return (
+    <div
+      className={`collab-panel p-3 bg-zinc-900 border-t border-zinc-700 flex flex-col gap-3 ${
+        expanded ? 'overflow-auto' : 'overflow-hidden'
+      } ${!height && expanded ? 'h-[50vh]' : ''}`}
+      style={panelStyle}
+    >
+      {/* Header with expand toggle */}
+      <div className="flex items-center gap-2">
+        <button
+          onClick={() => setExpanded(!expanded)}
+          className="text-zinc-400 hover:text-white p-1 text-lg"
+          title={expanded ? 'Collapse' : 'Expand'}
+        >
+          {expanded ? '▼' : '▲'}
+        </button>
+        <div className="text-xs text-zinc-400 flex items-center gap-2">
+          <span className={`w-2 h-2 rounded-full ${connected ? 'bg-green-500' : 'bg-red-500'}`} />
+          {connected ? 'Connected' : 'Disconnected'}
+        </div>
+      </div>
+
+      {/* Name input */}
+      <input
+        type="text"
+        placeholder="Your name"
+        value={name}
+        onChange={(e) => setName(e.target.value)}
+        className="bg-zinc-800 text-white px-2 py-2 rounded text-base border border-zinc-600"
+      />
+
+      {/* Prompt input */}
+      <div className="flex gap-2">
+        <input
+          type="text"
+          placeholder={image ? 'Describe what to do with this image...' : 'Make it funkier...'}
+          value={prompt}
+          onChange={(e) => setPrompt(e.target.value)}
+          onKeyDown={(e) => e.key === 'Enter' && submit()}
+          className="flex-1 bg-zinc-800 text-white px-2 py-2 rounded text-base border border-zinc-600"
+        />
+        <input type="file" accept="image/*" onChange={handleImageSelect} ref={fileInputRef} className="hidden" />
+        <button
+          onClick={() => fileInputRef.current?.click()}
+          className={`px-3 py-2 rounded text-base ${image ? 'bg-green-600 hover:bg-green-500' : 'bg-zinc-700 hover:bg-zinc-600'}`}
+          title={image ? 'Image attached - click to change' : 'Attach image'}
+        >
+          📷
+        </button>
+        <button
+          onClick={submit}
+          disabled={!prompt.trim() || !name.trim()}
+          className="bg-blue-600 hover:bg-blue-500 disabled:bg-zinc-700 px-4 py-2 rounded text-base"
+        >
+          Send
+        </button>
+        <input
+          type="number"
+          min="5"
+          max="300"
+          value={repeatInterval}
+          onChange={(e) => setRepeatInterval(Math.max(5, Math.min(300, parseInt(e.target.value) || 30)))}
+          className="w-16 bg-zinc-800 text-white px-2 py-2 rounded text-base border border-zinc-600"
+          title="Repeat interval in seconds"
+        />
+        <button
+          onClick={addRepeating}
+          disabled={!prompt.trim() || !name.trim()}
+          className="px-3 py-2 rounded text-base bg-zinc-700 hover:bg-zinc-600 disabled:bg-zinc-700"
+          title={`Add repeating prompt (every ${repeatInterval}s)`}
+        >
+          🔄
+        </button>
+      </div>
+
+      {/* Repeating prompts */}
+      {repeating.length > 0 && (
+        <div className="text-sm space-y-1">
+          <div className="text-zinc-400">Repeating prompts:</div>
+          {repeating.map((rp) => (
+            <div key={rp.id} className="flex items-center gap-2 bg-zinc-800 p-2 rounded text-orange-400">
+              <span className="flex-1">
+                🔄 {rp.name}: "{rp.prompt}" (every {rp.interval}s)
+              </span>
+              <button
+                onClick={() => removeRepeating(rp.id)}
+                className="text-red-400 hover:text-red-300 px-2"
+                title="Stop this repeating prompt"
+              >
+                ⏹
+              </button>
+            </div>
+          ))}
+        </div>
+      )}
+
+      {/* Image preview */}
+      {image && (
+        <div className="flex items-center gap-2 text-sm text-zinc-400">
+          <span>📷 Image attached</span>
+          <button onClick={clearImage} className="text-red-400 hover:text-red-300">
+            ✕ Remove
+          </button>
+        </div>
+      )}
+
+      {/* Queue */}
+      {queue.length > 0 && (
+        <div className={`flex flex-col ${expanded ? 'text-base max-h-32' : 'text-xs max-h-16'}`}>
+          <div className="text-zinc-400 mb-1 flex items-center justify-between">
+            <span>Queue ({queue.length})</span>
+            <button onClick={clearQueue} className="text-red-400 hover:text-red-300 text-sm px-2" title="Clear queue">
+              Clear
+            </button>
+          </div>
+          <div className="flex-1 overflow-y-auto space-y-1">
+            {queue.map((item, i) => (
+              <div key={i} className="bg-zinc-800 p-2 rounded text-zinc-300">
+                <span className="text-zinc-500">{item.name}:</span> {item.prompt}
+              </div>
+            ))}
+          </div>
+        </div>
+      )}
+
+      {/* History */}
+      <div className="flex-1 overflow-hidden flex flex-col min-h-0">
+        <div className={`text-zinc-400 mb-1 ${expanded ? 'text-base' : 'text-xs'}`}>History</div>
+        <div className="flex-1 overflow-y-auto space-y-1">
+          {[...history].reverse().map((entry, i) => (
+            <button
+              key={i}
+              onClick={() => playVersion(entry.code)}
+              className={`w-full text-left bg-zinc-800 hover:bg-zinc-700 p-2 rounded ${expanded ? 'text-base' : 'text-xs'}`}
+            >
+              <div className="text-zinc-300">
+                <span className="text-zinc-500">{entry.name}:</span> {entry.prompt}
+              </div>
+              {entry.error && (
+                <pre className="text-red-400 text-xs mt-1 whitespace-pre-wrap overflow-x-auto max-h-32 overflow-y-auto">
+                  {entry.error}
+                </pre>
+              )}
+            </button>
+          ))}
+          {history.length === 0 && (
+            <div className={`text-zinc-500 ${expanded ? 'text-base' : 'text-xs'}`}>No history yet</div>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+});
+
+export default CollabPanel;
