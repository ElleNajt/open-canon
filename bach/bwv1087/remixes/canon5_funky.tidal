-- Bach: Canon 5 from 14 Canons on the Goldberg Ground (BWV 1087)
-- FUNKY REMIX - Four-voice contrapuntal disco

setcps (116/60/4)  -- 116 BPM, disco tempo

do
  -- Track 1 - Disco strings, high voice
  d1 $ slow (26.0/4) 
     $ n "~ ~ ~ ~ g5 ~ fs5 ~ g5 ~ a5 ~ b5 ~ c6 ~ d6 ~ a5 ~ fs5 ~ d5 ~ e5 ~ fs5 ~ g5 ~ a5 ~ b5 ~ ~ ~ fs5 ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ ~ ~ a5 b5 c6 ~ b5 ~ a5 ~ g5 ~ b5 ~ a5 ~ g5 ~ a5 ~ g5 ~ fs5 ~ g5 ~ a5 ~ b5 ~ c6 ~ d6 ~ a5 ~ fs5 ~ d5 ~ e5 ~ fs5 ~ g5 ~ a5 ~ b5 ~ ~ ~ fs5 ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ ~ ~ a5 b5 c6 ~ b5 ~ a5 ~ g5 ~ b5 ~ a5 ~ g5 ~ a5 ~ g5 ~ fs5 ~ g5 ~ a5 ~ b5 ~ c6 ~ d6 ~ a5 ~ fs5 ~ d5 ~ e5 ~ fs5 ~ g5 ~ a5 ~ b5 ~ ~ ~ fs5 ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ ~ ~ a5 b5 c6 ~ b5 ~ a5 ~ g5 ~ b5 ~ a5 ~ g5 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
     # s "supersaw"
     # sustain 0.3
     # lpf 3500
     # gain 0.5
     # pan 0.2
     # room 0.3 # sz 0.6

  -- Track 2 - Inverted voice with phaser feel
  d2 $ slow (26.0/4) 
     $ jux (iter 2)
     $ n "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ d6 ~ e6 ~ d6 ~ c6 ~ b5 ~ a5 ~ g5 ~ c6 ~ e6 ~ g6 ~ fs6 ~ e6 ~ d6 ~ c6 ~ b5 ~ ~ ~ e6 ~ ~ ~ d6 ~ ~ ~ ~ ~ ~ ~ ~ ~ c6 b5 a5 ~ b5 ~ c6 ~ d6 ~ b5 ~ c6 ~ d6 ~ c6 ~ d6 ~ e6 ~ d6 ~ c6 ~ b5 ~ a5 ~ g5 ~ c6 ~ e6 ~ g6 ~ fs6 ~ e6 ~ d6 ~ c6 ~ b5 ~ ~ ~ e6 ~ ~ ~ d6 ~ ~ ~ ~ ~ ~ ~ ~ ~ c6 b5 a5 ~ b5 ~ c6 ~ d6 ~ b5 ~ c6 ~ d6 ~ c6 ~ d6 ~ e6 ~ d6 ~ c6 ~ b5 ~ a5 ~ g5 ~ c6 ~ e6 ~ g6 ~ fs6 ~ e6 ~ d6 ~ c6 ~ b5 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
     # s "supersquare"
     # sustain 0.25
     # lpf (range 1000 3000 $ slow 8 sine)
     # gain 0.45
     # pan 0.8

  -- Track 3 - Ground bass, disco octaves
  d3 $ slow (26.0/4)
     $ every 4 (sometimesBy 0.3 (stut 2 0.5 0.125))
     $ n "~ ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ fs4 ~ ~ ~ ~ ~ ~ ~ e4 ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ b3 ~ ~ ~ ~ ~ ~ ~ c4 ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ g3 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ fs4 ~ ~ ~ ~ ~ ~ ~ e4 ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ b3 ~ ~ ~ ~ ~ ~ ~ c4 ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ g3 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ fs4 ~ ~ ~ ~ ~ ~ ~ e4 ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ b3 ~ ~ ~ ~ ~ ~ ~ c4 ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ g3 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
     # s "superhoover"
     # sustain 0.6
     # lpf 700
     # gain 0.7
     # pan 0.5

  -- Track 4 - Low bass doubling
  d4 $ slow (26.0/4)
     $ (|- n 12)
     $ n "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ e4 ~ ~ ~ ~ ~ ~ ~ fs4 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ b4 ~ ~ ~ ~ ~ ~ ~ a4 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ e4 ~ ~ ~ ~ ~ ~ ~ fs4 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ b4 ~ ~ ~ ~ ~ ~ ~ a4 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ e4 ~ ~ ~ ~ ~ ~ ~ fs4 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
     # s "superhoover"
     # sustain 0.4
     # lpf 400
     # gain 0.65
     # pan 0.5

  -- Four-on-the-floor disco beat
  d5 $ stack [
       s "bd*4" # gain 1.0,
       s "~ cp ~ cp" # gain 0.85 # room 0.3,
       s "hh(3,8,1)" # gain 0.5 # pan 0.4,
       fast 2 $ s "~ oh" # gain 0.6 # pan 0.7
     ]

  -- Disco hi-hat shimmer
  d6 $ fast 2 
     $ s "hh*4" 
     # gain (slow 4 $ range 0.3 0.5 sine)
     # pan (range 0.3 0.7 rand)
     # speed 1.2

  -- String stabs on the offbeat
  d7 $ s "~ superstab ~ superstab"
     # n "g'maj"
     # sustain 0.1
     # gain 0.4
     # lpf 2000
     # room 0.4

hush
