-- Bach: Canon 1 from 14 Canons on the Goldberg Ground (BWV 1087)
-- FUNKY REMIX - Crunchy Rhodes vibes

setcps (92/60/4)  -- 92 BPM, laid back groove

do
  -- Track 1 - Rhodes-style lead with tremolo
  d1 $ slow (34.0/4) 
     $ sometimes (# room 0.3)
     $ n "~ ~ ~ ~ ~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ fs5 ~ ~ ~ ~ ~ ~ ~ e5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ b4 ~ ~ ~ ~ ~ ~ ~ c5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ fs5 ~ ~ ~ ~ ~ ~ ~ e5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ b4 ~ ~ ~ ~ ~ ~ ~ c5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ fs5 ~ ~ ~ ~ ~ ~ ~ e5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ b4 ~ ~ ~ ~ ~ ~ ~ c5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
     # s "supersaw"
     # sustain 0.6
     # lpf (range 600 2500 $ slow 16 sine)
     # lpq 0.2
     # gain 0.65
     # pan 0.35
     # room 0.2 # sz 0.4

  -- Track 2 - Funky clavinet bass with octave drop
  d2 $ slow (34.0/4) 
     $ (|- n 12)
     $ every 8 (jux (iter 4))
     $ n "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ g3 ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ c4 ~ ~ ~ ~ ~ ~ ~ b3 ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ e4 ~ ~ ~ ~ ~ ~ ~ fs4 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ g3 ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ c4 ~ ~ ~ ~ ~ ~ ~ b3 ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ e4 ~ ~ ~ ~ ~ ~ ~ fs4 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ g3 ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ c4 ~ ~ ~ ~ ~ ~ ~ b3 ~ ~ ~ ~ ~ ~ ~ d4 ~ ~ ~ ~ ~ ~ ~ e4 ~ ~ ~ ~ ~ ~ ~ fs4 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
     # s "superhoover"
     # sustain 0.5
     # lpf 600
     # gain 0.75
     # pan 0.5

  -- Drums - classic funk break
  d3 $ stack [
       s "bd ~ ~ bd ~ bd ~ ~" # gain 1.0,
       s "~ ~ ~ ~ sn ~ ~ ~" # gain 0.95 # room 0.2,
       s "hh(5,8)" # gain 0.6 # pan (range 0.4 0.6 rand)
     ]

  -- Ghost notes and fills
  d4 $ sometimesBy 0.15 (fast 2)
     $ s "~ ~ ~ ~ ~ ~ sn:3 ~"
     # gain 0.4
     # pan 0.6

  -- Shaker groove
  d5 $ s "shaker*8"
     # gain 0.35
     # pan (slow 4 $ range 0.3 0.7 sine)

hush
