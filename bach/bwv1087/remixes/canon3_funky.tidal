-- Bach: Canon 3 from 14 Canons on the Goldberg Ground (BWV 1087)
-- FUNKY REMIX - P-Funk Space Bass edition

setcps (108/60/4)  -- 108 BPM, driving funk

do
  -- Track 1 - Synth brass stabs
  d1 $ slow (26.0/4) 
     $ sometimesBy 0.2 (# crush 5)
     $ n "~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ e5 ~ ~ ~ ~ ~ ~ ~ fs5 ~ ~ ~ ~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ b5 ~ ~ ~ ~ ~ ~ ~ a5 ~ ~ ~ ~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ d6 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ e5 ~ ~ ~ ~ ~ ~ ~ fs5 ~ ~ ~ ~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ b5 ~ ~ ~ ~ ~ ~ ~ a5 ~ ~ ~ ~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ d6 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ e5 ~ ~ ~ ~ ~ ~ ~ fs5 ~ ~ ~ ~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
     # s "supersaw"
     # sustain 0.25
     # lpf (range 800 4000 $ slow 4 sine)
     # lpq 0.25
     # gain 0.6
     # pan 0.25
     # room 0.15

  -- Track 2 - Wah lead
  d2 $ slow (26.0/4) 
     $ every 4 (rev)
     $ n "~ ~ ~ ~ ~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ fs5 ~ ~ ~ ~ ~ ~ ~ e5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ b4 ~ ~ ~ ~ ~ ~ ~ c5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ fs5 ~ ~ ~ ~ ~ ~ ~ e5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ b4 ~ ~ ~ ~ ~ ~ ~ c5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ fs5 ~ ~ ~ ~ ~ ~ ~ e5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ b4 ~ ~ ~ ~ ~ ~ ~ c5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
     # s "supersquare"
     # sustain 0.4
     # lpf (range 300 2000 $ fast 2 sine)
     # lpq 0.4
     # gain 0.55
     # pan 0.75

  -- Slap bass - octave down, funky articulation
  d3 $ slow (26.0/4)
     $ (|- n 24)
     $ whenmod 8 6 (# crush 4)
     $ n "~ ~ ~ ~ ~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ fs5 ~ ~ ~ ~ ~ ~ ~ e5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ b4 ~ ~ ~ ~ ~ ~ ~ c5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ fs5 ~ ~ ~ ~ ~ ~ ~ e5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ b4 ~ ~ ~ ~ ~ ~ ~ c5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ g5 ~ ~ ~ ~ ~ ~ ~ fs5 ~ ~ ~ ~ ~ ~ ~ e5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ b4 ~ ~ ~ ~ ~ ~ ~ c5 ~ ~ ~ ~ ~ ~ ~ d5 ~ ~ ~ ~ ~ ~ ~ g4 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~"
     # s "superhoover"
     # sustain 0.3
     # lpf 500
     # gain 0.8
     # pan 0.5

  -- Drums - tight funk pocket
  d4 $ stack [
       s "bd ~ bd ~ ~ bd ~ bd" # gain 1.05,
       s "~ ~ ~ ~ cp ~ ~ ~" # gain 0.9 # room 0.25,
       fast 2 $ s "hh oh hh hh" # gain 0.55 # pan 0.6
     ]

  -- Funky conga pattern
  d5 $ s "~ [~ conga] ~ conga ~ [conga ~] conga ~"
     # n (irand 3)
     # gain 0.5
     # pan 0.4

  -- Wicky-wicky scratch fills
  d6 $ sometimesBy 0.1 id
     $ s "~ ~ ~ ~ ~ ~ ~ vinyl"
     # gain 0.4
     # speed "[1 -1 0.5]*3"

hush
