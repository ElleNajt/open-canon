#!/usr/bin/env bash
# Render a .tidal file to MP3 (fully automated)
# Usage: ./render input.tidal [cycles] [output.mp3]

set -e

SCLANG="/Applications/SuperCollider.app/Contents/MacOS/sclang"

if [ $# -lt 1 ]; then
    echo "Usage: ./render input.tidal [cycles] [output.mp3]"
    echo "  cycles: number of cycles to render (default: 8)"
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
INPUT="$(cd "$(dirname "$1")" && pwd)/$(basename "$1")"
CYCLES="${2:-8}"
BASENAME=$(basename "$INPUT" .tidal)
MP3_DIR="$SCRIPT_DIR/mp3"
mkdir -p "$MP3_DIR"
OUTPUT="${3:-$MP3_DIR/$BASENAME.mp3}"
WAVFILE="/tmp/open-canon-$$.wav"
SC_SCRIPT="/tmp/open-canon-sc-$$.scd"
TIDAL_SCRIPT="/tmp/open-canon-tidal-$$.hs"

# Parse CPS
CPS_LINE=$(grep "setcps" "$INPUT" | head -1 || echo "")
if [ -n "$CPS_LINE" ]; then
    CPS_EXPR=$(echo "$CPS_LINE" | sed -E 's/.*setcps[[:space:]]*\(?([^)]+)\)?/\1/' | tr -d ' ')
    CPS=$(echo "scale=4; $CPS_EXPR" | bc -l 2>/dev/null || echo "0.5")
else
    CPS="0.5"
fi

DURATION=$(echo "scale=0; $CYCLES / $CPS + 4" | bc)

echo "=== open-canon render ==="
echo "Input:    $(basename "$INPUT")"
echo "Cycles:   $CYCLES"  
echo "CPS:      $CPS"
echo "Duration: ${DURATION}s"
echo "Output:   $OUTPUT"
echo ""

# Cleanup on exit (but not the WAV)
cleanup() {
    rm -f "$SC_SCRIPT" "$TIDAL_SCRIPT"
}
trap cleanup EXIT

# Create SuperCollider script
cat > "$SC_SCRIPT" << EOF
(
s.options.numOutputBusChannels = 2;
// Use BlackHole for headless rendering, or env var override
s.options.device = "${SC_DEVICE:-BlackHole 2ch}";

s.waitForBoot {
    "=> Loading SuperDirt...".postln;
    ~dirt = SuperDirt(2, s);
    ~dirt.loadSoundFiles;
    s.sync;
    ~dirt.start(57120, 0 ! 12);
    s.sync;
    "=> SuperDirt ready".postln;
    
    {
        // Wait for Tidal to connect and start playing
        15.wait;
        
        "=> Recording...".postln;
        s.record("$WAVFILE");
        
        // Record for duration
        $DURATION.wait;
        
        s.stopRecording;
        "=> Recording complete".postln;
        
        1.wait;
        0.exit;
    }.fork;
};
)
EOF

# Create Tidal script
cat > "$TIDAL_SCRIPT" << 'BOOT'
:script /Users/elle/code/Tidal/BootTidal.hs
:set prompt ""
:set prompt-cont ""
BOOT

# Import and wait for connection
echo "import Control.Concurrent" >> "$TIDAL_SCRIPT"
echo "threadDelay 5000000" >> "$TIDAL_SCRIPT"  # 5 second wait for SuperDirt

# Add the pattern - wrap in :{ :} for multiline
echo ":{" >> "$TIDAL_SCRIPT"
# Filter out comments, hush, and blank lines
grep -v "^--" "$INPUT" | grep -v "^hush" | grep -v "^$" >> "$TIDAL_SCRIPT"
echo ":}" >> "$TIDAL_SCRIPT"

# Keep ghci alive with Haskell threadDelay (microseconds)
SLEEP_US=$((DURATION * 1000000 + 20000000))
echo "" >> "$TIDAL_SCRIPT"
echo "threadDelay $SLEEP_US" >> "$TIDAL_SCRIPT"

echo "Starting SuperCollider..."
"$SCLANG" "$SC_SCRIPT" 2>&1 &
SC_PID=$!

# Start Tidal early - it will wait for SuperDirt
echo "Starting Tidal..."
ghci < "$TIDAL_SCRIPT" &
TIDAL_PID=$!

# Wait for everything to sync
sleep 8

# Wait for SuperCollider to finish
wait $SC_PID 2>/dev/null || true

# Kill Tidal
kill $TIDAL_PID 2>/dev/null || true

echo ""

# Move WAV to output folder
echo "Looking for: $WAVFILE"
ls -la /tmp/open-canon-*.wav 2>/dev/null || echo "No wav files in /tmp"

if [ -f "$WAVFILE" ]; then
    WAVOUT="$MP3_DIR/$BASENAME.wav"
    mv "$WAVFILE" "$WAVOUT"
    echo ""
    echo "Done: $WAVOUT"
else
    # Maybe SC used a different path?
    echo "WAV not at expected location"
fi
