#!/usr/bin/env python3
"""
Hot-reload server for vibe-duet.
Bi-directional sync between live.js and Strudel browser.

- GET /live.js -> serves the file
- POST /save -> writes browser edits back to file
"""

import http.server
import socketserver
import subprocess
from pathlib import Path

PORT = 3333
ROOT = Path(__file__).parent
LIVE_FILE = ROOT / "live.js"

# Read host from config if it exists, else localhost
import json

CONFIG_FILE = ROOT / "config" / "local.json"
try:
    config = json.loads(CONFIG_FILE.read_text())
    HOST = config.get("host", "127.0.0.1")
except:
    HOST = "127.0.0.1"


class Handler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(ROOT), **kwargs)

    def end_headers(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        super().end_headers()

    def do_OPTIONS(self):
        self.send_response(200)
        self.end_headers()

    def do_POST(self):
        if self.path == "/save":
            length = int(self.headers.get("Content-Length", 0))
            code = self.rfile.read(length).decode("utf-8")
            LIVE_FILE.write_text(code)
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"OK")
            print("  [sync] Browser -> live.js")
        else:
            self.send_response(404)
            self.end_headers()

    def log_message(self, format, *args):
        if "live.js" in args[0] and "GET" in args[0]:
            pass  # quiet polling
        else:
            print(f"  {args[0]}")


print(f"""
vibe-duet
=========
Bi-directional sync between live.js and browser.

  File:    {LIVE_FILE}
  Server:  http://{HOST}:{PORT}

Edit in your editor OR in the browser - both stay in sync!

Press Ctrl+C to stop.
""")

with socketserver.TCPServer((HOST, PORT), Handler) as httpd:
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nStopped.")
