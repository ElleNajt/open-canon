#!/bin/bash
# vibe-duet - Start the live music environment
set -e
cd "$(dirname "$0")"

STRUDEL_REPO="git@codeberg.org:ElleNajt/strudel.git"

# Clone strudel fork if needed
if [ ! -d "strudel" ]; then
    echo "Cloning strudel fork..."
    git clone "$STRUDEL_REPO" strudel
    cd strudel
    echo "Installing dependencies..."
    pnpm install
    cd ..
fi

# Read host from config if it exists, else use localhost
if [ -f "config/local.json" ]; then
    HOST=$(python3 -c "import json; print(json.load(open('config/local.json')).get('host', '127.0.0.1'))" 2>/dev/null || echo "127.0.0.1")
else
    HOST="127.0.0.1"
fi

PORT=8090

# Build Strudel static files if needed
if [ ! -d "server/static" ]; then
    echo "Building Strudel frontend..."
    cd strudel/website
    SITE_URL="http://$HOST:$PORT/" pnpm run build
    cd ../..
    rm -rf server/static
    cp -r strudel/website/dist server/static
    echo "Frontend built."
fi

# Set up server venv if needed
if [ ! -d "server/.venv" ]; then
    echo "Setting up server..."
    python3 -m venv server/.venv
    server/.venv/bin/pip install -r server/requirements.txt
fi

# Load API key
if [ -f "server/.env" ]; then
    export $(cat server/.env | grep -v '^#' | xargs)
elif [ -n "$ANTHROPIC_API_KEY" ]; then
    : # already set
else
    echo "Warning: No ANTHROPIC_API_KEY found. Set it in server/.env or environment."
    echo "CollabPanel AI chat will not work without it."
fi

# Kill any existing servers
pkill -f "uvicorn main:app" 2>/dev/null || true
sleep 1

echo ""
echo "  ┌─────────────────────────────────────┐"
echo "  │         VIBE-DUET                   │"
echo "  │   Talk to AI. Hear music live.      │"
echo "  └─────────────────────────────────────┘"
echo ""

# Start FastAPI server
echo "Starting server..."
server/.venv/bin/uvicorn --app-dir server main:app --host $HOST --port $PORT &
SERVER_PID=$!

# Wait for server to be ready
echo "Waiting for server to start..."
sleep 3

# Open browser
echo "Opening browser..."
open "http://$HOST:$PORT" 2>/dev/null || xdg-open "http://$HOST:$PORT" 2>/dev/null || echo "Open http://$HOST:$PORT in your browser"

echo ""
echo "Ready!"
echo ""
echo "  Edit live.js in your editor - changes appear instantly"
echo "  Use the CollabPanel in-browser to chat with Claude"
echo ""
echo "Press Ctrl+C to stop."
echo ""

# Wait for interrupt
trap "kill $SERVER_PID 2>/dev/null; exit" INT
wait
