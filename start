#!/bin/bash
# vibe-duet - Start the live music environment
set -e
cd "$(dirname "$0")"

STRUDEL_REPO="git@codeberg.org:ElleNajt/strudel.git"

# Clone strudel fork if needed
if [ ! -d "strudel" ]; then
    echo "Cloning strudel fork..."
    git clone "$STRUDEL_REPO" strudel
    cd strudel
    echo "Installing dependencies..."
    pnpm install
    cd ..
fi

# Kill any existing servers
pkill -f "astro dev" 2>/dev/null || true
pkill -f "python.*serve" 2>/dev/null || true
sleep 1

# Read host from config if it exists, else use localhost
if [ -f "config/local.json" ]; then
    HOST=$(python3 -c "import json; print(json.load(open('config/local.json')).get('host', '127.0.0.1'))" 2>/dev/null || echo "127.0.0.1")
else
    HOST="127.0.0.1"
fi

echo ""
echo "  ┌─────────────────────────────────────┐"
echo "  │         VIBE-DUET                   │"
echo "  │   Talk to AI. Hear music live.      │"
echo "  └─────────────────────────────────────┘"
echo ""

# Start file server in background
python3 serve &
SERVE_PID=$!

# Start Strudel (bind to tailnet IP only)
echo "Starting Strudel..."
cd strudel
ASTRO_HOST=$HOST pnpm run start -- --host $HOST &
STRUDEL_PID=$!
cd ..

# Wait for Strudel to be ready
echo "Waiting for Strudel to start..."
sleep 8

# Open browser
echo "Opening browser..."
open http://$HOST:4321 2>/dev/null || xdg-open http://$HOST:4321 2>/dev/null || echo "Open http://$HOST:4321 in your browser"

echo ""
echo "Ready!"
echo ""
echo "  1. Click PLAY in Strudel"
echo "  2. Ask your AI to edit live.js"
echo "  3. Hear changes instantly!"
echo ""
echo "Press Ctrl+C to stop."
echo ""

# Wait for interrupt
trap "kill $SERVE_PID $STRUDEL_PID 2>/dev/null; exit" INT
wait
