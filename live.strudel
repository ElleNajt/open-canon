// Funky G minor groove
// Built from scratch with AI - bass, melody, chords, drums

setcps(100/60/4)  // 100 BPM

// Bass - syncopated funk
$: note("g2 ~ ~ g2 ~ g2 ~ ~ bb2 ~ ~ g2 ~ a2 ~ ~ g2 ~ ~ g2 ~ bb2 ~ ~ c3 ~ ~ bb2 ~ a2 ~ g2")
  .slow(2)
  .sound("sawtooth")
  .lpf("<400 500 350 600>")
  .gain("<0.7 0.8 0.65 0.85>")

// Melody
$: note("~ g4 ~ bb4 d5 ~ c5 ~ ~ a4 ~ g4 ~ ~ ~ ~ ~ f4 ~ g4 a4 ~ bb4 ~ ~ c5 ~ d5 ~ c5 ~ bb4")
  .slow(2)
  .sound("sawtooth")
  .lpf(perlin.range(2000, 5000).slow(4))
  .decay(0.2)
  .sustain(0.15)
  .gain("<0.65 0.75 0.6 0.8>")
  .every(4, rev)

// Ornaments - high sparkles
$: note("~ ~ d5 ~ ~ ~ g5 ~ ~ ~ ~ ~ f5 ~ ~ ~ ~ ~ ~ ~ bb5 ~ ~ ~ ~ ~ a5 ~ ~ ~ ~ ~")
  .slow(2)
  .mask("<1 0>")
  .sound("triangle")
  .gain(0.25)
  .delay(0.3)
  .delaytime(0.125)
  .delayfeedback(0.4)
  .pan(0.7)

// Chords - lush syncopated stabs
$: note("[g3,bb3,d4,g4] ~ ~ ~ [g3,bb3,d4,g4] ~ ~ [f3,a3,c4,f4] ~ ~ ~ ~ [f3,a3,c4,f4] ~ ~ ~")
  .slow(2)
  .sound("sawtooth")
  .lpf(2500)
  .decay(0.3)
  .sustain(0.2)
  .gain(0.3)
  .room(0.4)

// Drums
$: s("bd ~ ~ bd ~ bd ~ ~").gain(0.5)
$: s("hh*8").gain(0.25)
$: s("~ ~ ~ ~ cp ~ ~ ~").gain(0.4).room(0.2)
$: s("~ rim ~ ~ ~ rim ~ rim").gain(0.2)
$: s("~ ~ ~ ~ ~ ~ ~ [hh hh hh hh]").gain(0.3)
$: s("~ ~ ~ ~ ~ ~ [sn sn] ~?").gain(0.25)
