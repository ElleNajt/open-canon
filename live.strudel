// Bach Canon 9 - FUNKY REMIX
// Talk to your AI to change this!

setcps(120/60/4)  // 90 BPM - slower

// Track 1 - Lead with filter sweep
$: note("g5 ~ b5 ~ d6 ~ g6 ~ d6 ~ b5 ~ g5 ~ d6 ~ d5 ~ fs5 ~ a5 ~ db5 ~ e5 ~ g5 ~ db6 ~!3 d6 ~ a5 ~ fs5 ~ d5 ~ g5 ~ b5 ~ d6 ~ g5 ~ e6 ~ c6 ~ a5 ~ c6 ~ fs5 ~ a5 ~ d6 c6 b5 a5 g5 ~!7")
  .slow(33/4)
  .sound("sawtooth")
  .lpf(sine.range(400, 3000).slow(8))
  .decay(0.3)
  .sustain(0.2)
  .gain(0.5)
  .pan(0.3)

// Track 2 - Second voice (delayed canon entry)
$: note("~!2 g5 ~ b5 ~ d6 ~ g6 ~ d6 ~ b5 ~ g5 ~ d6 ~ d5 ~ fs5 ~ a5 ~ db5 ~ e5 ~ g5 ~ db6 ~!3 d6 ~ a5 ~ fs5 ~ d5 ~ g5 ~ b5 ~ d6 ~ g5 ~ e6 ~ c6 ~ a5 ~ c6 ~ fs5 ~ a5 ~ d6 c6 b5 a5 g5 ~!5")
  .slow(33/4)
  .sound("square")
  .decay(0.15)
  .sustain(0.1)
  .gain(0.4)
  .pan(0.7)

// Track 3 - Bass (Goldberg ground) - piano
$: note("~!8 g3 ~!7 fs3 ~!7 e3 ~!7 d3 ~!7 b2 ~!7 c3 ~!7 d3 ~!7 g2 ~!7")
  .slow(33/4)
  .s("piano")
  .gain(0.9)

// Drums
$: s("bd ~ ~ bd ~ ~ bd ~")
$: s("~ ~ hh ~ ~ hh ~ hh").gain(0.6)
$: s("~ ~ ~ ~ cp ~ ~ ~").gain(0.8).room(0.2)
