// Bach: Canon 9 from 14 Canons on the Goldberg Ground (BWV 1087)
// FUNKY REMIX

setcps(100/60/4)  // 100 BPM

// Track 1 - Lead with wah filter
$: n("g5 ~ b5 ~ d6 ~ g6 ~ d6 ~ b5 ~ g5 ~ d6 ~ d5 ~ fs5 ~ a5 ~ cs5 ~ e5 ~ g5 ~ cs6 ~!3 d6 ~ a5 ~ fs5 ~ d5 ~ g5 ~ b5 ~ d6 ~ g5 ~ e6 ~ c6 ~ a5 ~ c6 ~ fs5 ~ a5 ~ d6 c6 b5 a5 g5 ~ b5 ~ d6 ~ g6 ~ d6 ~ b5 ~ g5 ~ d6 ~ d5 ~ fs5 ~ a5 ~ cs5 ~ e5 ~ g5 ~ cs6 ~!3 d6 ~ a5 ~ fs5 ~ d5 ~ g5 ~ b5 ~ d6 ~ g5 ~ e6 ~ c6 ~ a5 ~ c6 ~ fs5 ~ a5 ~ d6 c6 b5 a5 g5 ~!7")
  .slow(33/4)
  .sometimesBy(0.1, x => x.crush(6))
  .s("sawtooth")
  .lpf(sine.range(400, 3000).slow(8))
  .lpq(0.3)
  .decay(0.3)
  .sustain(0.2)
  .gain(0.7)
  .pan(0.3)

// Track 2 - Funky clavinet sound  
$: n("~!2 g5 ~ b5 ~ d6 ~ g6 ~ d6 ~ b5 ~ g5 ~ d6 ~ d5 ~ fs5 ~ a5 ~ cs5 ~ e5 ~ g5 ~ cs6 ~!3 d6 ~ a5 ~ fs5 ~ d5 ~ g5 ~ b5 ~ d6 ~ g5 ~ e6 ~ c6 ~ a5 ~ c6 ~ fs5 ~ a5 ~ d6 c6 b5 a5 g5 ~ b5 ~ d6 ~ g6 ~ d6 ~ b5 ~ g5 ~ d6 ~ d5 ~ fs5 ~ a5 ~ cs5 ~ e5 ~ g5 ~ cs6 ~!3 d6 ~ a5 ~ fs5 ~ d5 ~ g5 ~ b5 ~ d6 ~ g5 ~ e6 ~ c6 ~ a5 ~ c6 ~ fs5 ~ a5 ~ d6 c6 b5 a5 g5 ~!5")
  .slow(33/4)
  .every(4, rev)
  .s("square")
  .decay(0.1)
  .sustain(0.1)
  .gain(0.5)
  .pan(0.7)

// Track 3 - Deep funky bass (octave down)
$: n("~!8 g3 ~!7 fs3 ~!7 e3 ~!7 d3 ~!7 b2 ~!7 c3 ~!7 d3 ~!7 g2 ~!7 g3 ~!7 fs3 ~!7 e3 ~!7 d3 ~!7 b2 ~!7 c3 ~!7 d3 ~!7 g2 ~!7")
  .slow(33/4)
  .s("sawtooth")
  .decay(0.5)
  .sustain(0.4)
  .gain(0.8)
  .lpf(800)
  .pan(0.5)

// Drum pattern - funky breakbeat
$: stack(
  s("bd ~ ~ bd ~ ~ bd ~").gain(0.9),
  s("~ ~ hh ~ ~ hh ~ hh").gain(0.5).pan(0.6),
  s("~ ~ ~ ~ cp ~ ~ ~").gain(0.7).room(0.3)
)

// Hi-hat groove
$: s("hh*8")
  .fast(2)
  .sometimesBy(0.3, x => x.gain(0.4))
  .gain(0.5)
  .pan(rand.range(0.4, 0.6))
