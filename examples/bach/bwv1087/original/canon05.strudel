// BWV 1087 Canon 5

// Baroque style voices
let upperVoice = x => x
  .sound("triangle")
  .gain(0.45)
  .attack(0.02)
  .decay(0.15)
  .sustain(0.2)
  .lpf(2500)
  .room(0.15)

let lowerVoice = x => x
  .sound("square")
  .gain(0.5)
  .decay(0.15)
  .sustain(0.2)
  .room(0.15)

setcps(120/60/4)

// Track 1
$: note("~!4 g5 ~ gb5 ~ g5 ~ a5 ~ b5 ~ c6 ~ d6 ~ a5 ~ gb5 ~ d5 ~ e5 ~ gb5 ~ g5 ~ a5 ~ b5 ~!3 gb5 ~!3 g5 ~!9 a5 b5 c6 ~ b5 ~ a5 ~ g5 ~ b5 ~ a5 ~ g5 ~ a5 ~ g5 ~ gb5 ~ g5 ~ a5 ~ b5 ~ c6 ~ d6 ~ a5 ~ gb5 ~ d5 ~ e5 ~ gb5 ~ g5 ~ a5 ~ b5 ~!3 gb5 ~!3 g5 ~!9 a5 b5 c6 ~ b5 ~ a5 ~ g5 ~ b5 ~ a5 ~ g5 ~ a5 ~ g5 ~ gb5 ~ g5 ~ a5 ~ b5 ~ c6 ~ d6 ~ a5 ~ gb5 ~ d5 ~ e5 ~ gb5 ~ g5 ~ a5 ~ b5 ~!3 gb5 ~!3 g5 ~!9 a5 b5 c6 ~ b5 ~ a5 ~ g5 ~ b5 ~ a5 ~ g5 ~!15")
  .slow(208/8/4)
  .apply(upperVoice)
  .pan(0.3)

// Track 2
$: note("~!36 d6 ~ e6 ~ d6 ~ c6 ~ b5 ~ a5 ~ g5 ~ c6 ~ e6 ~ g6 ~ gb6 ~ e6 ~ d6 ~ c6 ~ b5 ~!3 e6 ~!3 d6 ~!9 c6 b5 a5 ~ b5 ~ c6 ~ d6 ~ b5 ~ c6 ~ d6 ~ c6 ~ d6 ~ e6 ~ d6 ~ c6 ~ b5 ~ a5 ~ g5 ~ c6 ~ e6 ~ g6 ~ gb6 ~ e6 ~ d6 ~ c6 ~ b5 ~!3 e6 ~!3 d6 ~!9 c6 b5 a5 ~ b5 ~ c6 ~ d6 ~ b5 ~ c6 ~ d6 ~ c6 ~ d6 ~ e6 ~ d6 ~ c6 ~ b5 ~ a5 ~ g5 ~ c6 ~ e6 ~ g6 ~ gb6 ~ e6 ~ d6 ~ c6 ~ b5 ~!15")
  .slow(208/8/4)
  .apply(upperVoice)
  .pan(0.4)

// Track 3
$: note("~!8 g5 ~!7 gb5 ~!7 e5 ~!7 d5 ~!7 b4 ~!7 c5 ~!7 d5 ~!7 g4 ~!7 g5 ~!7 gb5 ~!7 e5 ~!7 d5 ~!7 b4 ~!7 c5 ~!7 d5 ~!7 g4 ~!7 g5 ~!7 gb5 ~!7 e5 ~!7 d5 ~!7 b4 ~!7 c5 ~!7 d5 ~!7 g4 ~!15")
  .slow(208/8/4)
  .apply(lowerVoice)
  .pan(0.6)

// Track 4
$: note("~!40 d4 ~!7 e4 ~!7 gb4 ~!7 g4 ~!7 b4 ~!7 a4 ~!7 g4 ~!7 d5 ~!7 d4 ~!7 e4 ~!7 gb4 ~!7 g4 ~!7 b4 ~!7 a4 ~!7 g4 ~!7 d5 ~!7 d4 ~!7 e4 ~!7 gb4 ~!7 g4 ~!15")
  .slow(208/8/4)
  .apply(lowerVoice)
  .pan(0.7)
