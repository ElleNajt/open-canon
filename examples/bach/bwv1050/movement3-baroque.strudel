// BWV 1050 Brandenburg Concerto No. 5 - Third Movement (Allegro)

// Baroque style voices
let upperVoice = x => x
  .sound("triangle")
  .gain(0.45)
  .attack(0.02)
  .decay(0.15)
  .sustain(0.2)
  .lpf(2500)
  .room(0.15)

let lowerVoice = x => x
  .sound("square")
  .gain(0.5)
  .decay(0.15)
  .sustain(0.2)
  .room(0.15)

setcps(90/60/4)

// Cembalo RH (Harpsichord Right Hand)
$: stack(
  note("~!166 d6 ~ a6 ~!5 e6 ~ gb6 ~ e6 ~!2 d6 ~!2 db6 ~ d6 ~!2 e6 ~!2 a5 ~ db6 ~!2 b5 ~!2 a5 ~ b5 ~!2 db6 ~!2 gb5 ~ b5 ~!2 a5 ~!2 ab5 ~ db6 ~!2 b5 ~!2 a5 ab5 a5 ~ b5 db6 d6 ~ e6 gb6 e6 ~ d6 db6 b5 ~ a5 db6 b5 ~ a5 ab5 gb5 ~ e5 gb5 e5 ~ d5 db5 b4 ~ a4 ~!7 a5 ~!7 a5 ~!7 ab5 ~!7 a5 b5 a5 b5 a5 b5 a5 b5 a5 b5 a5 b5 a5 b5 a5 b5 a5 ~ db6 ~!2 b5 ~!2 a5 ~ ab5 ~!2 gb5 ~!2 e5 gb5 e5 gb5 e5 gb5 e5 gb5 e5 gb5 e5 gb5 e5 gb5 e5 gb5 e5 ~ db5 ~!2 d5 ~!2 e5 ~ d5 ~!2 e5 ~!2 gb5 ~ a5 ~!2 ab5 ~!2 gb5 ~ a5 ~!2 ab5 ~!2 gb5 ~ eb5 ~!2 e5 ~!2 gb5 ~ e5 ~!2 gb5 ~!2 ab5 ~!7 db6 ~!7 db6 ~!7 b5 ~!7 b5 ~!7 a5 ~!5 d6 ~ e6 ~!5 gb6 ~ b5 ~!5 a5 ~ a5 ~!15"),
  note("~!392 b5 ~!7 a5 ~!7 gb5 ~!7 ab5 ~!7 db6 ~!15"),
  note("~!392 e6 ~!7 e6 ~!7 d6 ~!7 d6 ~!15")
)
  .slow(155.0/3)
  .apply(upperVoice)
  .pan(0.4)

